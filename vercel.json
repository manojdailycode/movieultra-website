{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/firebase-config",
      "destination": "/api/firebase-config.js"
    },
    {
      "source": "/api/tmdb",
      "destination": "/api/tmdb.js"
    },
    {
      "source": "/api/jikan",
      "destination": "/api/jikan.js"
    },
    {
      "source": "/api/omdb",
      "destination": "/api/omdb.js"
    },
    {
      "source": "/api/tvmaze",
      "destination": "/api/tvmaze.js"
    },
    {
       "source": "/((?!api(?:/|$))(?!.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
