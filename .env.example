# API Keys Configuration Example
# Copy this file to .env and fill in your keys

# TMDB API (Get from https://www.themoviedb.org/settings/api) - REQUIRED
TMDB_KEY=YOUR_TMDB_API_KEY

# Firebase Configuration (Get from Firebase Console -> Project Settings)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Optional Third-Party APIs
# OMDB: For IMDb, Rotten Tomatoes & Metacritic scores (Free key at https://www.omdbapi.com/apikey.aspx)
# If left blank, MovieUltra gracefully falls back to displaying TMDB ratings only.
OMDB_KEY=YOUR_OMDB_KEY

# TVMAZE: For television broadcast schedules & next episode air dates (Free public API - No API key required)

# Stream Obfuscation & Security
# STREAM_SECRET: Random 32-character string used to sign HMAC stream tokens (Recommended for production)
STREAM_SECRET=generate_a_random_32_character_secret_key_here

# SITE_URL: Your application URL for origin authorization
# - Locally: http://localhost:3000
# - On Vercel: https://your-project.vercel.app (or custom domain; optional as Vercel URLs are automatically recognized)
SITE_URL=http://localhost:3000
